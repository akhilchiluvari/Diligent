{
  "name": "diligent",
  "version": "1.0.0",
  "description": "Diligent: Autonomous AI Business Consultant & Multi-Agent Operational Engine for SMBs",
  "main": "server/server.js",
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix client",
    "postinstall": "npm install --prefix client",
    "test": "node server/tests/agentTest.js"
  },
  "keywords": [
    "ai-agent",
    "multi-agent",
    "grok",
    "smb",
    "retail-os",
    "hackathon",
    "microsoft-hyderabad"
  ],
  "author": "Akhil Chiluvari & Diligent Team",
  "license": "MIT",
  "dependencies": {
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "uuid": "^14.0.2"
  }
}
