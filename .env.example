# ========================================================================
# DILIGENT ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Multi-Agent Operational Engine for SMB Retail
# ========================================================================

PORT=5000
NODE_ENV=production

# ------------------------------------------------------------------------
# 1. GROQ CLOUD LPU CONFIGURATION (Ultra-Fast 120B Inference Engine)
# Get your free key at: https://console.groq.com/keys
# ------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Resilience Mode: When true, auto-falls back to local swarm if Groq limits hit
USE_MOCK_FALLBACK=true

# ------------------------------------------------------------------------
# 2. SUPABASE REST & AUTHENTICATION API KEYS
# Find in: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------
# Project URL (e.g., https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Public Anon Key (Used for user authentication and client queries under RLS)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# Secret Service Role Key (Used for backend administrative access, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here

# ------------------------------------------------------------------------
# 3. SUPABASE POSTGRESQL POOLER CONNECTION STRINGS
# Find in: Supabase Dashboard -> Project Settings -> Database -> Connection string
# ------------------------------------------------------------------------
# Transaction Pooler (Port 6543) - RECOMMENDED FOR VERCEL & SERVERLESS
# Example: postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Session Pooler (Port 5432) - For long-lived persistent connections & prepared statements
SESSION_POOLER_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Direct Database Connection (Port 5432) - Direct connection to Postgres host
DIRECT_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
