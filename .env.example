# Server Configuration
PORT=5000
NODE_ENV=production

# Groq Cloud LPU Configuration (120B Parameter High-Speed Inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Resilience Mode (Set to true to provide smart synthetic agent reasoning when keys are rate-limited or offline)
USE_MOCK_FALLBACK=true
